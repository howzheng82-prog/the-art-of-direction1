* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #090c15;
  color: #f3f5ff;
  font-family: system-ui, "Noto Sans", sans-serif;
  touch-action: none;
  user-select: none;
}

button,
input {
  font: inherit;
}

button {
  border: 1px solid #7180a8;
  background: #1b2542;
  color: white;
  border-radius: 12px;
  padding: 12px 22px;
  cursor: pointer;
}

button:active {
  transform: scale(0.98);
}

.screen {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hidden {
  display: none !important;
}

.panel,
.card {
  background: rgba(15, 20, 38, 0.94);
  border: 1px solid #53618a;
  border-radius: 20px;
  padding: 24px;
  box-shadow: 0 20px 80px #0008;
  max-width: 850px;
  width: min(92vw, 850px);
  max-height: 90vh;
  overflow: auto;
}

.titlebox {
  text-align: center;
  z-index: 2;
  text-shadow: 0 3px 20px #000;
}

.titlebox h1 {
  font-size: clamp(26px, 5vw, 64px);
  margin: 0 0 8px;
  letter-spacing: 1px;
}

.titlebox p {
  opacity: 0.8;
  margin: 0 0 28px;
}

.titlebox button {
  display: block;
  margin: 12px auto;
  min-width: 220px;
  font-size: 18px;
}

.subbtn {
  background: #11182c;
  color: #c8d0eb;
}

.stage-preview {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at center, #34405e 0, #161c31 45%, #080a12 100%);
}

.stage-preview:after {
  content: "";
  position: absolute;
  inset: 25% 8% 0;
  background: repeating-linear-gradient(90deg, #26304a 0 8%, #1a2238 8% 16%);
  opacity: 0.35;
  transform: perspective(400px) rotateX(25deg);
}

h2 {
  margin-top: 0;
}

.muted {
  opacity: 0.65;
}

.song {
  display: flex;
  align-items: center;
  gap: 14px;
  width: 100%;
  text-align: left;
  margin: 9px 0;
  background: #151e35;
}

.song .mark {
  font-size: 24px;
}

.song small {
  display: block;
  opacity: 0.65;
  margin-top: 4px;
}

.song.done {
  border-color: #80cfa0;
}

#rotate {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 99;
  background: #090c15;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 22px;
  padding: 30px;
}

#hud {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 12px 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(#080b16cc, transparent);
  font-size: clamp(11px, 1.8vw, 17px);
  z-index: 4;
}

#hud > div:first-child {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

#clock {
  opacity: 0.6;
  font-size: 0.8em;
}

.stats {
  margin-left: auto;
  margin-right: 18px;
}

#pauseBtn {
  padding: 7px 14px;
}

#scene {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background: #11182a;
}

.bandperson {
  position: absolute;
  transform: translate(-50%, -50%);
  text-align: center;
  transition: filter 0.15s;
}

.personbody {
  width: clamp(28px, 4vw, 65px);
  height: clamp(40px, 7vw, 105px);
  background: linear-gradient(90deg, #252e49, #667394, #252e49);
  border-radius: 45% 45% 18% 18%;
  margin: auto;
  position: relative;
}

.head {
  width: clamp(20px, 3vw, 42px);
  height: clamp(20px, 3vw, 42px);
  border-radius: 50%;
  background: #d6a88d;
  margin: auto;
  border: 2px solid #6b4e49;
}

.instrument {
  position: absolute;
  left: 50%;
  top: 35%;
  font-size: clamp(16px, 2.5vw, 35px);
  transform: translateX(-50%);
}

.bandperson.playing .instrument {
  filter: drop-shadow(0 0 7px #d8e6ff);
}

.note {
  position: absolute;
  top: -35px;
  left: 50%;
  font-size: 20px;
  opacity: 0.85;
}

.target {
  filter: drop-shadow(0 0 12px #8df0ff);
  outline: 3px solid #8df0ff;
  border-radius: 18px;
}

.overlay {
  position: absolute;
  inset: 0;
  background: #02040aaa;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.card button,
.card label {
  display: block;
  margin: 12px 0;
  width: 100%;
}

.card label {
  padding: 8px 0;
}

.card input {
  width: 100%;
}

#feedback {
  position: absolute;
  left: 50%;
  top: 18%;
  transform: translateX(-50%);
  font-size: clamp(18px, 3vw, 32px);
  font-weight: 700;
  z-index: 10;
  pointer-events: none;
  text-shadow: 0 2px 10px #000;
  opacity: 0;
}

#promptLayer {
  position: absolute;
  inset: 0;
  z-index: 6;
  pointer-events: none;
}

.prompt {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%) scale(0.3);
  font-size: clamp(35px, 8vw, 100px);
  font-weight: 800;
  text-shadow: 0 0 18px #9bc3ff;
  opacity: 0.95;
}

.special {
  font-size: clamp(20px, 4vw, 60px);
  border: 3px solid #9cc8ff;
  border-radius: 50%;
  width: clamp(60px, 9vw, 120px);
  height: clamp(60px, 9vw, 120px);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #20365caa;
}

